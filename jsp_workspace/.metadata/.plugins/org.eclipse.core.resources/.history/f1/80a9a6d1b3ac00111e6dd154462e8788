<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- 1. 애플리케이션 공통 초기화 파라미터 (ServletContext) -->
    <context-param>
        <param-name>company</param-name>
        <param-value>Globalin</param-value>
    </context-param>
    <context-param>
        <param-name>manager</param-name>
        <param-value>Jung Sub Kim</param-value>
    </context-param>

    <!-- 2. 서블릿 수동 매핑 -->
    <!-- HelloServlet -->
    <servlet>
        <servlet-name>my</servlet-name>
        <servlet-class>com.test.HelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>my</servlet-name>
        <url-pattern>/Hello</url-pattern>
    </servlet-mapping>

    <!-- LoginServlet -->
    <!-- <servlet>
        <servlet-name>Login</servlet-name>
        <servlet-class>com.test.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Login</servlet-name>
        <url-pattern>/login/Login</url-pattern>
    </servlet-mapping> -->

    <!-- SportServlet: 컨텍스트 패스 중복을 방지하기 위해 /test 제거 -->
    <servlet>
        <servlet-name>Sport</servlet-name>
        <servlet-class>com.test.SportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Sport</servlet-name>
        <url-pattern>/Sport</url-pattern>
    </servlet-mapping>

    <!-- MemberServlet: 404 방지를 위해 표준 경로 /member 로 정리 -->
    <servlet>
        <servlet-name>Member</servlet-name>
        <servlet-class>com.test.MemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Member</servlet-name>
        <url-pattern>/member</url-pattern>
    </servlet-mapping>

</web-app>