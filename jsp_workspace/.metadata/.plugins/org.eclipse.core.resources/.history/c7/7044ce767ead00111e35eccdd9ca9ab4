<%@page import="oracle.security.o5logon.a"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ page import="java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>초기화 파라미터 읽기</title>
</head>
<body>
초기화 파라미터 목록 :
<ul>
     <%
       Enumeration enumData = application.getInitParameterNames();
//                                                                (안에있는 내용을 불러옴)
         while(enumData.hasMoreElements()){
        	   String initParaName = (String)enumData.nextElement();
 
     %>
<li>
             <%=initParaName %> : <%=application.getInitParameter(initParaName) %>
</li>   
<%
} 
%>

</ul>

</body>
</html>