create table tempmember (
  id varchar2(20) not null,
  passwd varchar2(20),
  name varchar2(20),
  mem_num1 varchar2(6),
  mem_num2 varchar2(7),
  e_mail varchar2(30),
  phone varchar2(30),
  zipcode varchar2(7),
  address varchar2(60),
  job varchar2(30),
  primary key(id)
);

