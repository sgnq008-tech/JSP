<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ @ page import="java.util.*,com.jdbc.*" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Beans를 이용한 데이터베이스</title>
<link href="style.css" rel="stylesheet" type="text/css">
</head>
<body bgcolor="#ffffcc">
<h2>Beans를 사용한 데이터베이스</h2>
<h3>회원정보</h3>

<table bordercolor="#0000ff" border="1">
    <!-- 헤더 행 (총 9칸) -->
    <tr>
        <td><strong>ID</strong></td>
        <td><strong>PASSWD</strong></td>
        <td><strong>NAME</strong></td>
        <td><strong>MEM_NUM1</strong></td>
        <td><strong>MEM_NUM2</strong></td>
        <td><strong>E_MAIL</strong></td>
        <td><strong>PHONE</strong></td>
        <td><strong>ZIPCODE/ADDRESS</strong></td>
        <td><strong>JOB</strong></td>
    </tr>

<% 
    if (rs != null) {
        // 3. 행(Row)을 하나씩 읽으면서 데이터 추출
        while (rs.next()) {
            counter++; // 총 건수 증가

            id = rs.getString("id");
            passwd = rs.getString("passwd");
            name = rs.getString("name");
            mem_num1 = rs.getString("mem_num1");
            mem_num2 = rs.getString("mem_num2");
            e_mail = rs.getString("e_mail");
            phone = rs.getString("phone");
            zipcode = rs.getString("zipcode");
            address = rs.getString("address");
            job = rs.getString("job");
%>
    <!-- 한 사람(행)의 데이터 출력 (헤더와 똑같이 9칸) -->
    <tr>
        <td><%= id %></td>
        <td><%= passwd %></td>
        <td><%= name %></td>
        <td><%= mem_num1 %></td>
        <td><%= mem_num2 %></td>
        <td><%= e_mail %></td>
        <td><%= phone %></td>
        <!-- 우편번호와 주소를 묶어서 한 칸에 출력 -->
        <td><%= (zipcode != null ? zipcode : "") + " " + (address != null ? address : "") %></td>
        <td><%= job %></td>
    </tr>
<% 
        } // end while
    } // end if
%>
</table>
<br>

</body>
</html>