<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%
    String pageTitle = (String) request.getAttribute("PAGETITLE");
    if (pageTitle == null || pageTitle.trim().isEmpty()) {
        pageTitle = "기본 제목";
    }

    String contentPage = request.getParameter("CONTENTPAGE");
    if (contentPage == null || contentPage.trim().isEmpty()) {
        contentPage = "/temp/module/default.jsp"; // 기본 본문 페이지 경로 지정
    }
%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title><%= pageTitle %></title>
</head>
<body>
<table width="400" border="1" cellpadding="2" cellspacing="0">

    <tr>
        <td colspan="2">
            <jsp:include page="/temp/module/top.jsp" />
        </td>
    </tr>

    <tr>
        <td width="100" valign="top">
            <jsp:include page="/temp/module/left.jsp" flush="false" />
        </td>
        
        <td width="300" valign="top">
            <!-- 본문 내용 시작 -->
            <jsp:include page="<%= contentPage %>" flush="false" />
            <!-- 본문 내용 끝 -->
        </td>        
    </tr>

    <tr>
        <td colspan="2">
            <jsp:include page="/temp/module/bottom.jsp" />
        </td>
    </tr>

</table>
</body>
</html>